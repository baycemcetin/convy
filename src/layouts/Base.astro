---
// Page shell: tokens + type scale + font + hi-fi CSS, icon sprite, favicons (kimlik/logo/app/head.html), live region.
import '../styles/fonts.css';
import '../styles/tokens-volt.css';
import '../styles/type-scale.css';
import '../styles/hifi.css';
import '../styles/product.css';
import sprite from '../assets/sprite.svg?raw';
import { copy, type Lang } from '../i18n';
// Open Graph / Twitter card on indexable pages (OG image A "Volt ok", Cem 2026-11-08; public/og/convy-{lang}.png, 1200×630).
// alt: this page's path in each language (hreflang en/tr/x-default=en, both or none). noindex: robots meta, no canonical/hreflang.
// to: target label (e.g. "JPG") the converter presets on a pair page; read by queue.add from <html data-to>.
interface Props { lang: Lang; title?: string; description?: string; alt?: Record<Lang, string>; noindex?: boolean; to?: string; }
const { lang, title, description, alt, noindex, to } = Astro.props;
const t = copy(lang);
const pageTitle = title ?? `Convy · ${t.h1}`; // T10: title follows the page language
const abs = (p: string) => new URL(p, Astro.site);
---
<!doctype html>
<html lang={lang} data-theme="dark" data-to={to}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description ?? t.lead}>
{noindex ? <meta name="robots" content="noindex">
  : <link rel="canonical" href={abs(Astro.url.pathname)}>}
{!noindex && alt && <>
<link rel="alternate" hreflang="en" href={abs(alt.en)}>
<link rel="alternate" hreflang="tr" href={abs(alt.tr)}>
<link rel="alternate" hreflang="x-default" href={abs(alt.en)}>
</>}
{!noindex && <>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Convy">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description ?? t.lead}>
<meta property="og:url" content={abs(Astro.url.pathname)}>
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'}>
<meta property="og:locale:alternate" content={lang === 'en' ? 'tr_TR' : 'en_US'}>
<meta property="og:image" content={abs(`/og/convy-${lang}.png`)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={t.h1}>
<meta name="twitter:card" content="summary_large_image">
</>}
<slot name="head" />
<link rel="preload" href="/fonts/convy-ui.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#F5F6F2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0B0C0E" media="(prefers-color-scheme: dark)">
<!-- Before paint: explicit data-theme from the saved preference (none saved = the OS theme, followed live; the bar's [data-theme-toggle]
     button flips and saves it, one frame of data-motion="off", HAREKET §3.8) (hi-fi CSS keys on [data-theme]); and a pre-island
     drop/pick catcher so a file dropped before hydration is kept, not navigated to (Ek D); and the service worker
     (scripts/sw.mjs) registered after load (+ update(): every page load byte-checks sw.js, so a deploy replaces the shell
     at once instead of whenever the browser schedules it), outside the island budget. Hashed into the CSP at build. -->
<script is:inline>(function(d){var p;try{p=localStorage.getItem('convy-theme')}catch(e){}if(p!=='dark'&&p!=='light')p=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';d.documentElement.dataset.theme=p;var M=matchMedia('(prefers-color-scheme: light)');M.addEventListener&&M.addEventListener('change',function(m){var s;try{s=localStorage.getItem('convy-theme')}catch(e){}if(s!=='dark'&&s!=='light')d.documentElement.dataset.theme=m.matches?'light':'dark'});d.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-theme-toggle]');if(!b)return;var r=d.documentElement,v=r.dataset.theme==='light'?'dark':'light';r.dataset.motion='off';r.dataset.theme=v;try{localStorage.setItem('convy-theme',v)}catch(x){}requestAnimationFrame(function(){requestAnimationFrame(function(){delete r.dataset.motion})})});var q=window.__convyPending=[];['dragover','drop'].forEach(function(n){d.addEventListener(n,function(e){if(window.__convyReady||!e.dataTransfer)return;e.preventDefault();if(n==='drop')q.push.apply(q,e.dataTransfer.files)})});d.addEventListener('change',function(e){var i=e.target;if(!window.__convyReady&&i&&i.type==='file'&&i.files)q.push.apply(q,i.files)},true);var s=navigator.serviceWorker;if(s)addEventListener('load',function(){s.register('/sw.js').then(function(r){return r.update()}).catch(function(){})})})(document)</script>
</head>
<body>
<Fragment set:html={sprite} />
<a class="skip" href="#main">{t.skip}</a>
<slot />
<div id="live" class="sr" aria-live="polite"></div>
</body>
</html>
