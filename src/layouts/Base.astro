---
// Page shell: tokens + type scale + font + hi-fi CSS, icon sprite, favicons (kimlik/logo/app/head.html), live region.
import '../styles/fonts.css';
import '../styles/tokens-volt.css';
import '../styles/type-scale.css';
import '../styles/hifi.css';
import '../styles/product.css';
import sprite from '../assets/sprite.svg?raw';
import { copy, type Lang } from '../i18n';
interface Props { lang: Lang; title?: string; description?: string; }
const { lang, title, description } = Astro.props;
const t = copy(lang);
const pageTitle = title ?? `Convy · ${t.h1}`; // T10: title follows the page language
const alt = lang === 'en' ? '/tr/' : '/';
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description ?? t.lead}>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
<link rel="alternate" hreflang="en" href={new URL('/', Astro.site)}>
<link rel="alternate" hreflang="tr" href={new URL('/tr/', Astro.site)}>
<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)}>
<link rel="preload" href="/fonts/convy-ui.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#F5F6F2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0B0C0E" media="(prefers-color-scheme: dark)">
<!-- Before paint: explicit data-theme from the saved preference (hi-fi CSS keys on [data-theme]); and a pre-island
     drop/pick catcher so a file dropped before hydration is kept, not navigated to (Ek D). Hashed into the CSP at build. -->
<script is:inline>(function(d){var p;try{p=localStorage.getItem('convy-theme')}catch(e){}if(p!=='dark'&&p!=='light')p=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';d.documentElement.dataset.theme=p;var q=window.__convyPending=[];['dragover','drop'].forEach(function(n){d.addEventListener(n,function(e){if(window.__convyReady||!e.dataTransfer)return;e.preventDefault();if(n==='drop')q.push.apply(q,e.dataTransfer.files)})});d.addEventListener('change',function(e){var i=e.target;if(!window.__convyReady&&i&&i.type==='file'&&i.files)q.push.apply(q,i.files)},true)})(document)</script>
</head>
<body>
<Fragment set:html={sprite} />
<a class="skip" href="#main">{t.skip}</a>
<slot />
<div id="live" class="sr" aria-live="polite"></div>
</body>
</html>
