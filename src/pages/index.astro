---
import Base from '../layouts/Base.astro';
import App from '../components/App.svelte';
import HowBand from '../components/HowBand.astro';
import Formats from '../components/Formats.astro';
import Footer from '../components/Footer.astro';
import { islandCopy, copy } from '../i18n';
import { webApp } from '../lib/ld';
import { navHref, HOME, HOME_META, both } from '../i18n/site';
import wm from '../assets/convy-wordmark.svg?raw';
---
<Base lang="en" {...HOME_META.en} alt={both((l) => HOME[l])}>
  <script type="application/ld+json" slot="head" set:html={webApp("en", HOME.en, copy("en").lead)} />
  <App lang="en" t={islandCopy("en")} hrefs={navHref("en")} alt={HOME.tr} client:load><Fragment slot="wm" set:html={wm} /><Formats lang="en" /><HowBand lang="en" /></App>
  <Footer lang="en" />
</Base>
