---
import Base from '../layouts/Base.astro';
import App from '../components/App.svelte';
import HowBand from '../components/HowBand.astro';
import Footer from '../components/Footer.astro';
import { islandCopy } from '../i18n';
import wm from '../assets/convy-wordmark-kucuk.svg?raw';
---
<Base lang="en">
  <App lang="en" t={islandCopy("en")} client:load><Fragment slot="wm" set:html={wm} /><HowBand lang="en" /></App>
  <Footer lang="en" />
</Base>
