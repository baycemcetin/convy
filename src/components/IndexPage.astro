---
// P3: every published pair by category and source format. The one internal-link hub (SEO-SAYFALAR §2.6); only published pairs are listed.
import { render } from 'astro:content';
import Content from '../layouts/Content.astro';
import { loadDocs, loadPairs } from '../content/publish';
import { CATEGORIES, fmtName, kindOf, pairUrl } from '../content/conversions';
import { DOC, INDEX, both, CHROME } from '../i18n/site';
import { breadcrumb } from '../lib/ld';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = (await loadDocs()).index[lang], c = CHROME[lang];
const { Content: Intro } = await render(e);
const { pubs } = await loadPairs();
const cats = CATEGORIES.map((k) => {
  const rows = new Map<string, typeof pubs>();
  for (const p of pubs) if (kindOf(p.c.from) === k) rows.set(p.c.from, [...(rows.get(p.c.from) ?? []), p]);
  return { k, rows: [...rows] };
}).filter((x) => x.rows.length);
---
<Content lang={lang} title={e.data.title} description={e.data.description} alt={both((l) => INDEX[l])} noindex={e.data.draft}>
  <script type="application/ld+json" slot="head" set:html={breadcrumb([[c.home, lang === 'en' ? '/' : '/tr/'], [c.convert, INDEX[lang]]])} />
  <h1>{e.data.h1}</h1>
  <div class="lead"><Intro /></div>
  {e.data.draft && <p class="draftnote">{c.draftNote}</p>}
  {cats.map(({ k, rows }) => (
    <section class="cx" id={k}><h2>{c.cat[k]}</h2><div class="b idx">
      {rows.map(([from, ps]) => <div class="row"><b>{fmtName(from)}</b><ul class="links">{ps.map((p) => <li><a href={pairUrl(p.c, lang)}>{fmtName(p.c.to)}</a></li>)}</ul></div>)}
    </div></section>
  ))}
</Content>
