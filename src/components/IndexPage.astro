---
// P3: every published pair by category and source format. The one internal-link hub (SEO-SAYFALAR §2.6); only published pairs are listed.
import { render } from 'astro:content';
import Content from '../layouts/Content.astro';
import Formats from './Formats.astro';
import { loadDocs } from '../content/publish';
import { DOC, INDEX, both, CHROME } from '../i18n/site';
import { breadcrumb } from '../lib/ld';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = (await loadDocs()).index[lang], c = CHROME[lang];
const { Content: Intro } = await render(e);
---
<Content lang={lang} title={e.data.title} description={e.data.description} alt={both((l) => INDEX[l])} noindex={e.data.draft}>
  <script type="application/ld+json" slot="head" set:html={breadcrumb([[c.home, lang === 'en' ? '/' : '/tr/'], [c.convert, INDEX[lang]]])} />
  <header class="panel dhero"><h1>{e.data.h1}</h1><div class="lead"><Intro /></div></header>
  {e.data.draft && <p class="draftnote">{c.draftNote}</p>}
  <Formats lang={lang} index />
</Content>
