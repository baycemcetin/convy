---
// Renders its slot (a page's markdown body) to HTML and puts build-time blocks where the markdown left a marker:
// `<!-- licenses -->` → the license table generated from the installed packages (src/lib/licenses.ts);
// `<!-- formats -->` → the format table generated from the format lists (src/lib/format-table.ts).
import { licenseTable } from '../lib/licenses';
import { formatTable } from '../lib/format-table';
import type { Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const html = (await Astro.slots.render('default'))
  .replace('<!-- licenses -->', () => licenseTable(lang))
  .replace('<!-- formats -->', () => formatTable(lang));
// One .cx section per h2 (heading left, text right from 1024 px): the same section template as the pair pages. Text before the first h2 = unlabeled intro.
const sections = html.split(/(?=<h2[\s>])/).filter((s) => s.trim()).map((s) => {
  if (!s.startsWith('<h2')) return `<div class="cx"><div class="b">${s}</div></div>`;
  const k = s.indexOf('</h2>') + 5;
  return `<section class="cx">${s.slice(0, k)}<div class="b">${s.slice(k)}</div></section>`;
}).join('');
---
<Fragment set:html={sections} />
